{
  "name": "joee-quality",
  "version": "0.1.0",
  "description": "Evidence-first quality evaluation CLI and Agent Skill",
  "type": "module",
  "bin": {
    "jqs": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "config",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "schema": "npm run build && node dist/schemas/export.js config/report.schema.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^14.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
